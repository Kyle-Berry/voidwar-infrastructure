
flowchart TB
    Internet(["Public Internet"])
    Players(["Minecraft Players"])
    Admin(["Administrator"])
    Workstation["Admin Workstation<br/>Terraform / AWS SSO"]

    subgraph Server["OVHcloud Dedicated Server - Ubuntu 22.04 LTS"]
        direction TB

        subgraph Web["Containerized Web Layer"]
            direction LR

            Nginx["Nginx<br/>Public ports 80 / 443"]
            Static["Static Site<br/>voidwar.net"]
            Grafana["Grafana<br/>127.0.0.1:3000"]

            Nginx -->|"Serve"| Static
            Nginx -->|"Reverse proxy<br/>grafana.voidwar.net"| Grafana
        end

        subgraph Monitoring["Containerized Monitoring"]
            direction LR

            Prometheus["Prometheus<br/>127.0.0.1:9090"]
            NodeExporter["Node Exporter<br/>127.0.0.1:9100"]
            HostMetrics["Ubuntu Host Metrics"]

            Grafana -->|"Query"| Prometheus
            Prometheus -->|"Scrape"| NodeExporter
            NodeExporter -->|"Read-only host view"| HostMetrics
        end

        subgraph Native["Native Minecraft and Backup Workloads"]
            direction LR

            Tmux["tmux Console"]
            Minecraft["Minecraft Server<br/>Java / Paper"]
            PluginData["External Plugin Data<br/>/srv/plugins"]
            Cron["cron<br/>Nightly backup"]
            Backup["backup_system.sh<br/>Archive / Validate / GFS"]
            BackupStorage["Local GFS Backups<br/>Daily / Weekly / Monthly"]
            Uploader["upload_s3_backups.sh<br/>AWS CLI"]

            Tmux --> Minecraft
            PluginData -.->|"plugins symlink"| Minecraft
            Cron --> Backup
            Backup -->|"Graceful stop / restart"| Minecraft
            PluginData -.->|"Included in archive"| Backup
            Backup --> BackupStorage
            BackupStorage --> Uploader
        end

        subgraph Security["Security and TLS Automation"]
            direction LR

            SSH["SSH<br/>Key-only access"]
            UFW["UFW<br/>Minimal exposure"]
            Fail2Ban["Fail2Ban<br/>systemd journal"]
            Certbot["Certbot Timer<br/>Automated renewal"]
            Certificates["Let's Encrypt<br/>Certificates"]

            Fail2Ban -->|"Protects"| SSH
            UFW -.-> Nginx
            UFW -.-> SSH
            Certbot -->|"Renew"| Certificates
            Certificates -->|"Read-only mount"| Nginx
        end
    end

    subgraph AWS["Amazon Web Services - us-east-2"]
        direction TB

        S3["Private S3 Backup Bucket<br/>Daily / Weekly / Monthly"]
        IAM["IAM Backup Uploader<br/>Put / List - No Get / Delete"]
        Lifecycle["S3 Lifecycle Policies<br/>Expiration / Version Cleanup"]

        Lifecycle -.->|"Retention rules"| S3
    end

    Internet -->|"HTTP / HTTPS"| Nginx
    Players -->|"Minecraft protocol"| Minecraft
    Admin -->|"SSH / SFTP"| SSH
    Admin --> Workstation

    Workstation -->|"Terraform provisioning"| S3
    Workstation -->|"Terraform provisioning"| IAM
    Workstation -->|"Terraform provisioning"| Lifecycle

    Uploader -->|"AWS CLI / HTTPS<br/>Offsite uploads"| S3
    IAM -.->|"Least-privilege permissions"| Uploader

    classDef external fill:#ddf4ff,stroke:#0969da,stroke-width:2px,color:#24292f;
    classDef web fill:#fff8c5,stroke:#9a6700,stroke-width:2px,color:#24292f;
    classDef monitoring fill:#dafbe1,stroke:#1a7f37,stroke-width:2px,color:#24292f;
    classDef native fill:#fbefff,stroke:#8250df,stroke-width:2px,color:#24292f;
    classDef security fill:#ffebe9,stroke:#cf222e,stroke-width:2px,color:#24292f;
    classDef cloud fill:#e6f4ea,stroke:#1a7f37,stroke-width:2px,color:#24292f;

    class Internet,Players,Admin,Workstation external;
    class Nginx,Static,Grafana web;
    class Prometheus,NodeExporter,HostMetrics monitoring;
    class Tmux,Minecraft,PluginData,Cron,Backup,BackupStorage,Uploader native;
    class SSH,UFW,Fail2Ban,Certbot,Certificates security;
    class S3,IAM,Lifecycle cloud;
